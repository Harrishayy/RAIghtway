# ── Data source ──────────────────────────────────────────────────────────────
# mock: built-in sample data with a live upload simulation (no backend needed)
# http: the REST API (architecture.md §5)
NEXT_PUBLIC_DATA_SOURCE=mock

# Server-side: where Next proxies /api/* to. Keeps the browser same-origin.
# The backend runs on the VM (backend/run.sh, port 8000); from a laptop, tunnel it first:
#   ssh -N -L 8000:localhost:8000 bc-<user>
RAIGHTWAY_API_URL=http://localhost:8000

# Optional: call a backend directly from the browser instead (needs CORS on the backend).
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Optional: override endpoint paths (JSON). Keys: videos, video, issues, similar, frame, report,
# regenerateReport, dispatch, upload, search, videoFile. "{id}" is replaced.
# NEXT_PUBLIC_API_ENDPOINTS={"videoFile":"/api/videos/{id}/file","search":"/api/v1/search"}

# Optional: switch features on or off for this backend (JSON). Keys: upload, dispatch,
# regenerateReport, similar, topicSearch, frames.
# NEXT_PUBLIC_API_CAPABILITIES={"topicSearch":true}

# Optional: request timeout and polling (ms)
# NEXT_PUBLIC_API_TIMEOUT_MS=15000
# NEXT_PUBLIC_POLL_LIVE_MS=1000
# NEXT_PUBLIC_POLL_IDLE_MS=10000

# Optional: crew depot "lat,lon,label"
# NEXT_PUBLIC_DEPOT=43.6502,-79.3627,Front St E depot

# Optional: offline basemap (toronto | none) and default look (survey | night | paint)
# NEXT_PUBLIC_BASEMAP=toronto
# NEXT_PUBLIC_DEFAULT_DIRECTION=survey
