{
  "name": "raightway-frontend",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @raightway/web dev",
    "dev:mock": "NEXT_PUBLIC_DATA_SOURCE=mock pnpm --filter @raightway/web dev",
    "dev:live": "node tooling/dev-live.mjs",
    "backend:status": "node tooling/dev-live.mjs status",
    "backend:restart": "node tooling/dev-live.mjs restart",
    "backend:logs": "node tooling/dev-live.mjs logs",
    "build": "pnpm --filter @raightway/web build",
    "start": "pnpm --filter @raightway/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}
